{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Watchtower",
  "version": "0.2.0",
  "identifier": "dev.watchtower.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Watchtower",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "externalBin": [],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "license": "MIT",
    "shortDescription": "Local IP camera monitor",
    "longDescription": "A private desktop RTSP and ONVIF camera monitor with identity-based address recovery.",
    "resources": {
      "../src/player/vendor/LICENSE": "licenses/go2rtc.txt",
      "../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../../LICENSE": "licenses/WATCHTOWER-MIT.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
